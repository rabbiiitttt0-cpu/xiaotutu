# ===== 小图兔：环境变量模板（复制为 .env 后填写；.env 已 gitignore 勿入库）=====

# Docker 镜像 tag
IMAGE_TAG=v1.0.0

# 数据库：留空则本地 SQLite 兜底（data/app.db）；生产填 PostgreSQL
# DATABASE_URL=postgresql+psycopg2://xiaotutu:你的密码@db:5432/xiaotutu

# PostgreSQL（docker-compose db 服务用，仅内网）
POSTGRES_USER=xiaotutu
POSTGRES_PASSWORD=改成随机强密码
POSTGRES_DB=xiaotutu
